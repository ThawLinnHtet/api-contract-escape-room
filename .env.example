# neon deploy fills .env.local with real values. Keep them out of Git.
DATABASE_URL="<NEON_POOLED_POSTGRES_URL>"
DATABASE_URL_UNPOOLED="<NEON_DIRECT_POSTGRES_URL>"
NEON_BRANCH="production"

# Optional for HTTPS-only cloud environments; omit to use PostgreSQL TCP.
# DATABASE_TRANSPORT="neon-websocket"
